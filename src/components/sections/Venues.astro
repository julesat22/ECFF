---
import { VENUES } from '@/content/venues'
import SectionHead from '@/components/ui/SectionHead.astro'
---

<section class="venues" id="venues" aria-labelledby="venues-heading">
  <div class="container">
    <SectionHead
      id="venues-heading"
      kicker="The Map"
      title={'Three screens, <span class="it">one</span> beautiful <span class="it">valley</span>.'}
      right="Three historic rooms across Joseph and Enterprise."
      centered
    />
    <ul class="venues-grid" role="list">
      {
        VENUES.map((v) => (
          <li class="venue">
            <p class="vn">Venue N° {v.n}</p>
            <p class="vname">{v.name}</p>
            <p class="vaddr">{v.addr}</p>
            <p class="vrole">{v.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .venues {
    background: var(--color-paper);
    padding: 0 0 120px;
  }
  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 36px;
  }
  .venues-grid {
    list-style: none;
    padding: 48px 0 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--color-rule);
  }
  .venue {
    padding: 40px 32px 44px;
    border-right: 1px solid var(--color-rule);
    transition: background-color 150ms ease;
  }
  .venue:nth-child(3n) {
    border-right: 0;
  }
  /* Hover lift only on devices that actually have a hover capability —
     keeps mobile taps from leaving a "stuck" highlight on the card the
     user just touched (and signals that venue cards are not clickable). */
  @media (hover: hover) {
    .venue:hover {
      background: rgba(0, 0, 0, 0.03);
    }
  }
  .vn {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .vname {
    margin: 0;
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .vaddr {
    margin: 12px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--color-ink);
    opacity: 0.75;
  }
  .vrole {
    display: inline-block;
    margin: 22px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  @media (max-width: 980px) {
    .venues {
      /* Mobile section rhythm: 36px top/bottom across all sections. */
      padding: 36px 0;
    }
    .container {
      padding: 0 20px;
    }
    .venues-grid {
      grid-template-columns: 1fr;
      /* 22px gap matches the section's 22px padding rhythm. */
      padding-top: 22px;
    }
    /* Center every line of card content on mobile. The .vrole element
       is display: inline-block, so its border-top hugs the role text and
       sits centered along with everything else. */
    .venue {
      border-right: 0;
      border-bottom: 1px solid var(--color-rule);
      padding: 26px 0;
      text-align: center;
    }
    .venue:last-child {
      border-bottom: 0;
    }
    .vname {
      font-size: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .venue {
      transition: none;
    }
  }
</style>

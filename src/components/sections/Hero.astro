---
import { FEST } from '@/content/festival'
import { Countdown } from '@/components/islands/Countdown/Countdown'
---

<header class="hero" id="top">
  <p class="hero-edition" aria-hidden="true">Festival {FEST.edition} · {FEST.year}</p>
  <div class="hero-inner">
    <p class="hero-eyebrow">
      <span class="dot" aria-hidden="true"></span>
      <span>The Inaugural Festival</span>
    </p>

    <h1 class="hero-title">
      <span class="line-1">Eagle Cap</span><br />
      <span class="italic">Film Festival</span>
    </h1>

    <dl class="hero-meta">
      <div class="cell">
        <dt class="lbl">Dates</dt>
        <dd class="val">Nov 5 — 7</dd>
      </div>
      <div class="cell">
        <dt class="lbl">Festival</dt>
        <dd class="val">N° I / 2026</dd>
      </div>
      <div class="cell">
        <dt class="lbl">Place</dt>
        <dd class="val">Joseph, Oregon</dd>
      </div>
      <div class="cell">
        <dt class="lbl">This Year</dt>
        <dd class="val serif">18 films · 10 directors · 3 screens</dd>
      </div>
    </dl>

    <div class="hero-countdown">
      <Countdown client:load targetIso={FEST.startDate} />
      <p class="cd-label">
        Until the <em>lights go down</em> on opening night, Nov 5, at the OK Theatre.
      </p>
    </div>
  </div>

  <img
    class="hero-mountain"
    src="/assets/mountain.png"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
  />
</header>

<style>
  .hero {
    position: relative;
    background: var(--color-black);
    color: var(--color-offwhite);
    overflow: hidden;
    border-bottom: 1px solid var(--color-rule-dark);
    user-select: none;
    -webkit-user-select: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 65%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 25%,
      rgba(0, 0, 0, 0.7) 60%,
      rgba(0, 0, 0, 0.9) 100%
    );
    pointer-events: none;
    z-index: 2;
  }
  .hero-inner {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 74px 36px 52px;
    min-height: 760px;
    z-index: 3;
  }
  .hero-edition {
    position: absolute;
    right: 36px;
    top: 56px;
    margin: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-muted-dark);
    z-index: 3;
  }
  .hero-eyebrow {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-muted-dark);
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--color-yellow);
    border-radius: 50%;
    animation: hero-dot-pulse 2.6s ease-in-out infinite;
  }
  @keyframes hero-dot-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.5);
      opacity: 0.6;
    }
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(80px, 14vw, 220px);
    line-height: 0.88;
    letter-spacing: -0.01em;
    margin: 28px 0 0;
    text-transform: uppercase;
    font-weight: 400;
    position: relative;
    z-index: 3;
  }
  .hero-title .line-1 {
    position: relative;
    z-index: 4;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
    animation: hero-fade-up 1100ms cubic-bezier(0.2, 0.8, 0.2, 1) 80ms both;
  }
  .hero-title .italic {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    text-transform: none;
    letter-spacing: -0.02em;
    font-size: 0.78em;
    position: relative;
    z-index: 3;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
    display: inline-block;
    animation: hero-fade-up 1100ms cubic-bezier(0.2, 0.8, 0.2, 1) 320ms both;
  }
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero-meta {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.4fr;
    gap: 24px;
    margin: 58px 0 0;
    position: relative;
    z-index: 3;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.75);
  }
  .cell {
    margin: 0;
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 8px;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.95),
      0 0 14px rgba(0, 0, 0, 0.8);
  }
  .val {
    margin: 0;
    font-family: var(--font-display);
    font-size: 34px;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .val.serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .hero-countdown {
    position: relative;
    z-index: 3;
    margin-top: 28px;
    padding: 28px 0 36px;
    border-top: 1px solid var(--color-rule-dark);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.75);
  }
  .cd-label {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    max-width: 360px;
    color: var(--color-offwhite);
    opacity: 0.85;
  }
  .cd-label em {
    color: var(--color-yellow);
    font-style: italic;
  }
  .hero-mountain {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) translateY(var(--parallax-y, 0));
    bottom: -298px;
    width: 100vw;
    height: auto;
    max-width: none;
    pointer-events: none;
    z-index: 1;
    opacity: 0.85;
    filter: brightness(0.9) contrast(1.1) saturate(0.85);
    will-change: transform;
  }

  @media (max-width: 980px) {
    .hero-inner {
      /* Top: clear sticky nav (~56px) + breathing room for the title's ascender.
         Bottom: tight band where the mountain peek lives — no dead 100vh space.
         min-height removed so the hero hugs its content. */
      padding: 60px 20px 86px;
      min-height: 0;
    }
    .hero-edition {
      display: none;
    }
    .hero-eyebrow {
      font-size: 10px;
      letter-spacing: 0.18em;
      gap: 10px;
    }
    .hero-title {
      font-size: clamp(56px, 17vw, 88px);
      line-height: 0.92;
      margin-top: 16px;
    }
    .hero-title .italic {
      font-size: 0.82em;
    }
    .hero-meta {
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 28px;
      padding-top: 20px;
    }
    .lbl {
      font-size: 9px;
      letter-spacing: 0.18em;
      margin-bottom: 4px;
    }
    .val {
      font-size: 22px;
    }
    .val.serif {
      font-size: 16px;
      line-height: 1.2;
    }
    .hero-countdown {
      margin-top: 28px;
      padding: 20px 0 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .cd-label {
      font-size: 15px;
      max-width: 100%;
    }
    .hero-mountain {
      /* Anchored to the hero's bottom band. Sized so it reads as a horizon
         line, not a wall. Slightly off-bottom so its black pixels don't
         butt-up against the next section's edge. */
      width: 200%;
      bottom: -10px;
      opacity: 0.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title .line-1,
    .hero-title .italic,
    .dot {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .hero-inner {
      padding: 56px 20px 76px;
    }
    .hero-meta {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .val {
      font-size: 20px;
    }
    .hero-mountain {
      width: 240%;
      bottom: -10px;
    }
  }
</style>
